<% layout('layouts/boilerplate')%>
<div class="row">
    <h1 class="text-center">Create a New Game for <%=player.name%>!</h1>
    <div class="col-6 offset-3">
        <form action="/players/<%=player._id%>/games" method="POST" novalidate class="validated-form">
            <!-- Main Stats -->
            <div class="mb-3">
                <label class="form-label" for="points">Points</label>
                <input class="form-control" input type="number" id="points" name="game[points]" required>
                <div class="valid-feedback">
                    Looks good!
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="assists">Assists</label>
                <input class="form-control" input type="number" id="assists" name="game[assists]" required>
                <div class="valid-feedback">
                    Looks good!
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="rebounds">Rebounds</label>
                <input class="form-control" input type="number" id="rebounds" name="game[rebounds]" required>
                <div class="valid-feedback">
                    Looks good!
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="steals">Steals</label>
                <input class="form-control" input type="number" id="steals" name="game[steals]" required>
                <div class="valid-feedback">
                    Looks good!
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="blocks">Blocks</label>
                <input class="form-control" input type="number" id="blocks" name="game[blocks]" required>
                <div class="valid-feedback">
                    Looks good!
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="turnovers">Turnovers</label>
                <input class="form-control" input type="number" id="turnovers" name="game[turnovers]" required>
                <div class="valid-feedback">
                    Looks good!
                </div>
            </div>
            <!-- Advanced Stats -->
            <div class="mb-3">
                <label class="form-label" for="fga">Field Goals Attempted</label>
                <input class="form-control" input type="number" id="fga" name="game[fga]" required>
                <div class="valid-feedback">
                    Looks good!
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="fgm">Field Goals Made</label>
                <input class="form-control" input type="number" id="fgm" name="game[fgm]" required>
                <div class="valid-feedback">
                    Looks good!
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="tpa">Threes Attempted</label>
                <input class="form-control" input type="number" id="tpa" name="game[tpa]" required>
                <div class="valid-feedback">
                    Looks good!
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="tpm">Threes Made</label>
                <input class="form-control" input type="number" id="tpm" name="game[tpm]" required>
                <div class="valid-feedback">
                    Looks good!
                </div>
            </div>
            <div class="mb-3">
                <button class="btn btn-success">Create Game</button>
            </div>
        </form>
        <div class="mb-3">
            <a href="/players/<%= player._id%>" class="btn btn-primary">Back to Player</a>
        </div>
    </div>
</div>